{
  "name": "super-toy-plane-combat",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Arcade 3D multiplayer dogfighting in a giant toy house and garden.",
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.mjs",
    "start": "node dist-server/index.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "preview": "npm run build && npm start",
    "server": "tsx server/index.ts"
  },
  "dependencies": {
    "@colyseus/core": "^0.16.26",
    "@colyseus/schema": "^3.0.76",
    "@colyseus/ws-transport": "^0.16.5",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "colyseus": "^0.16.5",
    "colyseus.js": "^0.16.22",
    "express": "^4.21.2",
    "three": "^0.187.0"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/three": "^0.187.0",
    "concurrently": "^9.1.2",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.8"
  }
}
